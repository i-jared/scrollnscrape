{
  "name": "scrollnscrape",
  "displayName": "Scrollnscrape",
  "version": "0.0.1",
  "description": "x dot com profile scraper",
  "author": "jared. <jared@lmbrt.net>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://x.com/*",
      "https://twitter.com/*"
    ],
    "permissions": [
      "activeTab"
    ]
  },
  "overrides": {
    "@parcel/reporter-dev-server@>=2.0.0 <2.16.4": "2.16.4",
    "@vue/server-renderer@>=3.0.0 <3.5.42": "3.5.42",
    "content-security-policy-parser@>=0.0.0 <0.6.0": "0.6.0",
    "esbuild@>=0.0.0 <0.25.0": "0.25.0",
    "fflate@>=0.0.0 <0.8.3": "0.8.3",
    "msgpackr@>=1.0.0 <1.10.1": "1.10.1",
    "sharp@>=0.0.0 <0.35.5": "0.35.5",
    "browserslist@>=4.0.0 <4.28.7": "4.28.7",
    "svelte@^4.0.0": "5.55.7",
    "tsup@^7.0.0": "9.0.0"
  },
  "packageManager": "bun@1.4.4"
}
